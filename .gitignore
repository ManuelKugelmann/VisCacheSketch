captures/
*.exr
*.hdr

# VisCache passes copied into Falcor tree by setup.sh (generated, not tracked)
Falcor/Source/RenderPasses/VisCache/
Falcor/Source/RenderPasses/ReSTIRPTPass/

# Runtime directory (build output or downloaded release)
runtime/

# Downloaded test scenes (use scripts/download_scenes.sh)
media/
Source/RenderPasses/*/Data/VeachAjar/models/
Source/RenderPasses/*/Data/VeachAjar/textures/

# Downloaded reference papers — tracked in git (LFS recommended for large PDFs)
# docs/references/

# Slang CI check artifacts (downloaded binary + test log)
slang-dist/
slang-check-results.log

# Generated paper (built by CI, deployed to Pages)
viscachepaper/paper-combined.md
.scripts/.mode
.agents/
runtime/.runstate/

# Claude Code per-user settings (allowlist, local permissions). Shared project
# settings (hooks, enforced rules) belong in .claude/settings.json.
.claude/settings.local.json
.claude/scheduled_tasks.lock
