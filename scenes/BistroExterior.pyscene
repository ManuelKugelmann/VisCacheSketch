# BistroExterior.pyscene — Amazon Lumberyard Bistro (Exterior)
# VisCache paper experiments — camera and settings for outdoor street view.
#
# Expects: runtime/media/Bistro/BistroExterior.fbx (downloaded via download_scenes.bat).
# Source:  NVIDIA ORCA (CC-BY 4.0), https://developer.nvidia.com/orca
#
# Lighting approach follows SirKero/RTProgressivePhotonMapper:
# boost all emissives by 1000x and configure glass for transmission.

import os as _os
_dir = _os.path.dirname(_os.path.abspath(__file__))
_fbx = _os.path.join(_dir, '..', 'runtime', 'media', 'Bistro', 'BistroExterior.fbx')
if not _os.path.exists(_fbx):
    _fbx = 'BistroExterior.fbx'
sceneBuilder.importScene(_fbx)

# Camera — street-level view of the bistro facade
camera = Camera('VisCacheDefault')
camera.position = float3(-8.0, 2.5, -0.3)
camera.target   = float3( 3.0, 1.5, -1.5)
camera.up       = float3( 0.0, 1.0,  0.0)
camera.focalLength = 24.0
sceneBuilder.addCamera(camera)

# Boost all emissive materials (FBX defaults are far too dim)
for m in sceneBuilder.materials:
    m.emissiveFactor *= 1000

# Glass — make windows transparent (pattern from SirKero/RTProgressivePhotonMapper)
glass = sceneBuilder.getMaterial('MASTER_Glass_Exterior')
if glass:
    glass.specularTransmission = 1
    glass.roughness = 0
    glass.metallic = 0
    glass.doubleSided = True
    glass.indexOfRefraction = 1.55
    glass.nestedPriority = 5

tGlass = sceneBuilder.getMaterial('TransparentGlass')
if tGlass:
    tGlass.specularTransmission = 1
    tGlass.roughness = 0
    tGlass.metallic = 0
    tGlass.doubleSided = True
    tGlass.indexOfRefraction = 1.55
    tGlass.nestedPriority = 5

# Directional sunlight — warm late-afternoon sun from the side
sun = DirectionalLight('Sun')
sun.intensity = float3(3.0, 2.4, 1.7)
sun.direction = float3(0.6, -0.7, -0.3)
sceneBuilder.addLight(sun)

# Sky fill — cool ambient from opposite direction
skyFill = DirectionalLight('SkyFill')
skyFill.intensity = float3(0.15, 0.2, 0.35)
skyFill.direction = float3(-0.4, -0.5, 0.3)
sceneBuilder.addLight(skyFill)

# Render settings
settings = sceneBuilder.renderSettings
settings.useAnalyticLights = True
settings.useEmissiveLights = True
