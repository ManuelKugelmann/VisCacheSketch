# Sponza.pyscene — Crytek Sponza Atrium
# Classic GI benchmark — sun through open roof.
#
# Expects: runtime/media/Sponza/ with sponza.obj + textures/

import os
_dir = os.path.dirname(os.path.abspath(__file__))
_sponza_obj = os.path.join(_dir, '..', 'runtime', 'media', 'Sponza', 'sponza.obj')
if not os.path.exists(_sponza_obj):
    _sponza_obj = 'sponza.obj'
sceneBuilder.importScene(_sponza_obj)

# Camera — classic atrium view
camera = Camera('VisCacheDefault')
# Sponza OBJ is in centimeters — Falcor OBJ importer does NOT rescale
# (~3600 wide, ~1500 tall, ~2300 deep in cm)
# Classic view: from one end of the atrium looking down the length
camera.position = float3(-800.0, 200.0, -150.0)
camera.target   = float3(600.0, 150.0, 50.0)
camera.up       = float3(0.0, 1.0, 0.0)
camera.focalLength = 21.0
camera.farPlane = 10000.0
sceneBuilder.addCamera(camera)

# Sun — harsh midday through the open roof
sun = DirectionalLight('Sun')
sun.intensity = float3(53.0, 48.0, 40.0)
sun.direction = float3(0.1, -1.0, 0.05)
sceneBuilder.addLight(sun)

# Render settings — sun + sky only, no fill
settings = sceneBuilder.renderSettings
settings.useAnalyticLights = True
settings.useEmissiveLights = True
settings.useEnvLight = True
