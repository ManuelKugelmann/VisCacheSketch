# Landscape.pyscene — Manhattan + Bistro in Central Park
#
# Scale-agnosticism stress test for VisCache.
# Manhattan OSM (~21 km, 2.9M tris) provides city-scale extent.
# Bistro (~50m, 2.8M tris) sits in Central Park with full material detail.
# Tests the spatial hash across ~10000x scale range in a single scene.
#
# Requires:
#   - Manhattan model: download from Sketchfab (free, CC-BY 4.0)
#   - Bistro: run scripts/download_scenes.sh

import os

# ---------------------------------------------------------------------------
# Locate Manhattan model (required)
# ---------------------------------------------------------------------------
_dir = os.path.dirname(os.path.abspath(__file__))

_manhattan_candidates = [
    os.path.join(_dir, '..', 'runtime', 'media', 'Manhattan', 'scene.gltf'),
    os.path.join(_dir, '..', 'runtime', 'media', 'Manhattan', 'scene.glb'),
    os.path.join(_dir, '..', 'runtime', 'media', 'Manhattan', 'manhattan.obj'),
    'scene.gltf',
    'manhattan.obj',
]
_manhattan = None
for _path in _manhattan_candidates:
    if os.path.exists(_path):
        _manhattan = _path
        break

if _manhattan is None:
    raise FileNotFoundError(
        'Manhattan model not found. Download from Sketchfab:\n'
        '  https://sketchfab.com/3d-models/manhattan-osm-complete-model-bad7b7c7c6a64febb83950c24fee4d00\n'
        'Extract to runtime/media/Manhattan/'
    )

# ---------------------------------------------------------------------------
# Locate Bistro (required)
# ---------------------------------------------------------------------------
_bistro_candidates = [
    os.path.join(_dir, '..', 'runtime', 'media', 'Bistro', 'BistroExterior.fbx'),
    'BistroExterior.fbx',
]
_bistro = None
for _path in _bistro_candidates:
    if os.path.exists(_path):
        _bistro = _path
        break

if _bistro is None:
    raise FileNotFoundError(
        'Bistro not found. Run scripts/download_scenes.sh first.'
    )

# ---------------------------------------------------------------------------
# Import Manhattan (city-scale backdrop)
# ---------------------------------------------------------------------------
sceneBuilder.importScene(_manhattan)

# ---------------------------------------------------------------------------
# Import Bistro placed in Central Park
#
# The Manhattan OSM model coordinate system varies by export tool.
# Central Park is roughly at the center of the island, ~6 km from the
# southern tip. Adjust BISTRO_OFFSET after loading to align visually.
# Bistro is ~50m extent — tiny relative to the ~21 km island.
# ---------------------------------------------------------------------------
BISTRO_OFFSET = float3(0.0, 0.0, 3000.0)

# Import Bistro under a transform node to place it in Central Park
bistroNode = sceneBuilder.addNode('BistroInPark', Transform(
    translation=BISTRO_OFFSET,
))
sceneBuilder.importScene(_bistro)

# Boost Bistro emissives (FBX defaults too dim)
for m in sceneBuilder.materials:
    if m.emissive:
        m.emissiveFactor = max(m.emissiveFactor, 100.0)

# Glass materials (pattern from BistroExterior.pyscene)
glass = sceneBuilder.getMaterial('MASTER_Glass_Exterior')
if glass:
    glass.specularTransmission = 1
    glass.roughness = 0
    glass.metallic = 0
    glass.doubleSided = True
    glass.indexOfRefraction = 1.55
    glass.nestedPriority = 5

tGlass = sceneBuilder.getMaterial('TransparentGlass')
if tGlass:
    tGlass.specularTransmission = 1
    tGlass.roughness = 0
    tGlass.metallic = 0
    tGlass.doubleSided = True
    tGlass.indexOfRefraction = 1.55
    tGlass.nestedPriority = 5

# ---------------------------------------------------------------------------
# Lighting — afternoon sun across the Manhattan grid
# ---------------------------------------------------------------------------
sun = DirectionalLight('Sun')
sun.intensity = float3(6.0, 5.2, 4.0)
sun.direction = float3(0.5, -0.8, 0.3)
sceneBuilder.addLight(sun)

sky = DirectionalLight('SkyFill')
sky.intensity = float3(0.6, 0.7, 1.0)
sky.direction = float3(-0.2, -1.0, -0.1)
sceneBuilder.addLight(sky)

# ---------------------------------------------------------------------------
# Camera — street level at the Bistro, Manhattan skyline visible
# ---------------------------------------------------------------------------
camera = Camera('LandscapeDefault')
camera.position = float3(
    BISTRO_OFFSET.x - 8.0,
    BISTRO_OFFSET.y + 2.5,
    BISTRO_OFFSET.z - 0.3,
)
camera.target = float3(
    BISTRO_OFFSET.x + 3.0,
    BISTRO_OFFSET.y + 1.5,
    BISTRO_OFFSET.z - 1.5,
)
camera.up = float3(0.0, 1.0, 0.0)
camera.focalLength = 24.0
camera.farPlane = 50000.0
sceneBuilder.addCamera(camera)

settings = sceneBuilder.renderSettings
settings.useAnalyticLights = True
settings.useEmissiveLights = True
settings.useEnvLight = True
