# CornellBox_32PointLights.pyscene — Cornell Box with 32 scattered point lights.
#
# Low-powered colored point lights scattered inside the room.
# Stress test for multi-light VisCache: many overlapping shadow regions,
# each light has distinct color for visual identification.
import os
exec(open(os.path.join(os.path.dirname(__file__) or ".", "CornellBox_Base.py")).read())

# ---------------------------------------------------------------------------
# 32 scattered colored point lights — primary and secondary hues, low power.
# ---------------------------------------------------------------------------
import colorsys

random.seed(123)
n_lights = 32
total_power = 3.0
per_light = total_power / n_lights

# Cycle R → Y → G → C → B → M for strong, distinct colors
_hues = [0.0, 1/6, 2/6, 3/6, 4/6, 5/6]

for idx in range(n_lights):
    while True:
        px = random.uniform(-0.85, 0.85)
        py = random.uniform(0.15, 1.85)
        pz = random.uniform(-0.85, 0.85)
        # Reject if inside tall box region
        if abs(px - 0.35) < 0.4 and py < 1.3 and abs(pz - 0.3) < 0.4:
            continue
        break

    r, g, b = colorsys.hls_to_rgb(_hues[idx % 6], 0.5, 1.0)
    intensity = float3(r * per_light, g * per_light, b * per_light)

    light = PointLight(f'PL_{idx:02d}')
    light.intensity = intensity
    light.position  = float3(px, py, pz)
    sceneBuilder.addLight(light)

settings = sceneBuilder.renderSettings
settings.useAnalyticLights = True
settings.useEmissiveLights = False
