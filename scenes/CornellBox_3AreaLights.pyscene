# CornellBox_3AreaLights.pyscene — 3 colored area lights (ceiling warm, red wall, green wall).
import os
exec(open(os.path.join(os.path.dirname(__file__) or ".", "CornellBox_Base.py")).read())

light_ceil = StandardMaterial('LightCeil')
light_ceil.baseColor = float4(1.0, 1.0, 1.0, 1.0)
light_ceil.emissiveColor = float3(30.0, 24.0, 18.0)
light_ceil.emissiveFactor = 1.0
light_ceil.roughness = 1.0

light_red = StandardMaterial('LightRed')
light_red.baseColor = float4(1.0, 0.2, 0.2, 1.0)
light_red.emissiveColor = float3(120.0, 15.0, 7.5)
light_red.emissiveFactor = 1.0
light_red.roughness = 1.0

light_green = StandardMaterial('LightGreen')
light_green.baseColor = float4(0.2, 1.0, 0.3, 1.0)
light_green.emissiveColor = float3(15.0, 90.0, 22.5)
light_green.emissiveFactor = 1.0
light_green.roughness = 1.0

addQuad('CeilingLight', light_ceil,
    float3(-0.15, 1.98, -0.15), float3(0.15, 1.98, -0.15),
    float3(0.15, 1.98, 0.15), float3(-0.15, 1.98, 0.15),
    0, -1, 0)

addQuad('RedWallLight', light_red,
    float3(-0.98, 0.9, 0.1), float3(-0.98, 0.9, -0.1),
    float3(-0.98, 1.1, -0.1), float3(-0.98, 1.1, 0.1),
    1, 0, 0)

addQuad('GreenWallLight', light_green,
    float3(0.98, 0.9, -0.1), float3(0.98, 0.9, 0.1),
    float3(0.98, 1.1, 0.1), float3(0.98, 1.1, -0.1),
    -1, 0, 0)

settings = sceneBuilder.renderSettings
settings.useAnalyticLights = False
settings.useEmissiveLights = True
