# CornellBox.pyscene — Procedural Cornell Box (no external OBJ needed)
#
# Built with Falcor's TriangleMesh API. All normals face inward.
# Camera at -Z looking into the box.

# Materials
white = StandardMaterial('White')
white.baseColor = float4(0.73, 0.73, 0.73, 1.0)

red = StandardMaterial('Red')
red.baseColor = float4(0.65, 0.05, 0.05, 1.0)

green = StandardMaterial('Green')
green.baseColor = float4(0.12, 0.45, 0.15, 1.0)

light_mat = StandardMaterial('Light')
light_mat.baseColor = float4(1.0, 1.0, 1.0, 1.0)
light_mat.emissiveColor = float3(50.0, 40.0, 30.0)
light_mat.emissiveFactor = 1.0

def addQuad(name, mat, p0, p1, p2, p3, nx, ny, nz):
    """Add a quad with explicit normal. Vertices in CCW order when viewed from normal direction."""
    m = TriangleMesh()
    m.name = name
    n = float3(nx, ny, nz)
    m.addVertex(p0, n, float2(0, 0))
    m.addVertex(p1, n, float2(1, 0))
    m.addVertex(p2, n, float2(1, 1))
    m.addVertex(p3, n, float2(0, 1))
    m.addTriangle(0, 1, 2)
    m.addTriangle(0, 2, 3)
    meshID = sceneBuilder.addTriangleMesh(m, mat)
    nodeID = sceneBuilder.addNode(name)
    sceneBuilder.addMeshInstance(nodeID, meshID)

# Room: 2x2x2, floor at Y=0, centered at X=0 Z=0
L, R = -1.0, 1.0
B, T =  0.0, 2.0
Bk   =  1.0       # back wall Z
Fr   = -1.0       # front (open) Z — camera side

# Floor: normal UP (0,1,0) — CCW when viewed from above
addQuad('Floor', white,
    float3(L, B, Bk), float3(R, B, Bk), float3(R, B, Fr), float3(L, B, Fr),
    0, 1, 0)

# Ceiling: normal DOWN (0,-1,0) — CCW when viewed from below
addQuad('Ceiling', white,
    float3(L, T, Fr), float3(R, T, Fr), float3(R, T, Bk), float3(L, T, Bk),
    0, -1, 0)

# Back wall: normal toward camera (0,0,-1) — CCW when viewed from -Z
addQuad('BackWall', white,
    float3(R, B, Bk), float3(L, B, Bk), float3(L, T, Bk), float3(R, T, Bk),
    0, 0, -1)

# Left wall (green): normal RIGHT (1,0,0) — CCW when viewed from +X
addQuad('LeftWall', green,
    float3(L, B, Fr), float3(L, B, Bk), float3(L, T, Bk), float3(L, T, Fr),
    1, 0, 0)

# Right wall (red): normal LEFT (-1,0,0) — CCW when viewed from -X
addQuad('RightWall', red,
    float3(R, B, Bk), float3(R, B, Fr), float3(R, T, Fr), float3(R, T, Bk),
    -1, 0, 0)

# Ceiling light: normal DOWN (0,-1,0) — emits into the room
addQuad('CeilingLight', light_mat,
    float3(-0.3, 1.98, 0.3), float3(0.3, 1.98, 0.3), float3(0.3, 1.98, -0.3), float3(-0.3, 1.98, -0.3),
    0, -1, 0)

# Tall box (left side, slightly rotated)
tall = TriangleMesh.createCube(float3(0.6, 1.2, 0.6))
tall.name = 'TallBox'
tallID = sceneBuilder.addTriangleMesh(tall, white)
tallNode = sceneBuilder.addNode('TallBox', Transform(
    translation=float3(-0.35, 0.6, 0.3),
    rotationEulerDeg=float3(0, 15, 0),
))
sceneBuilder.addMeshInstance(tallNode, tallID)

# Short box (right side, slightly rotated)
short = TriangleMesh.createCube(float3(0.6, 0.6, 0.6))
short.name = 'ShortBox'
shortID = sceneBuilder.addTriangleMesh(short, white)
shortNode = sceneBuilder.addNode('ShortBox', Transform(
    translation=float3(0.35, 0.3, -0.2),
    rotationEulerDeg=float3(0, -15, 0),
))
sceneBuilder.addMeshInstance(shortNode, shortID)

# Camera
camera = Camera('CornellBoxCam')
camera.position = float3(0.0, 1.0, -2.8)
camera.target   = float3(0.0, 1.0, 0.0)
camera.up       = float3(0.0, 1.0, 0.0)
camera.focalLength = 35.0
sceneBuilder.addCamera(camera)

settings = sceneBuilder.renderSettings
settings.useAnalyticLights = False
settings.useEmissiveLights = True
