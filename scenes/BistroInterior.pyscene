# BistroInterior.pyscene — Amazon Lumberyard Bistro (Interior)
# VisCache paper experiments — camera and settings tuned for indoor GI.
#
# Expects: runtime/media/Bistro/BistroInterior.fbx (downloaded via download_scenes.bat).
# Source:  NVIDIA ORCA (CC-BY 4.0), https://developer.nvidia.com/orca
#
# Lighting approach follows SirKero/RTProgressivePhotonMapper and
# TU-Clausthal-Rendering/ReSTIR-FG: boost all emissives by 1000x
# (the FBX has emissive lamps/signs at very low default intensity),
# and configure glass materials for proper specular transmission.

import os as _os
_dir = _os.path.dirname(_os.path.abspath(__file__))
_fbx = _os.path.join(_dir, '..', 'runtime', 'media', 'Bistro', 'BistroInterior.fbx')
if not _os.path.exists(_fbx):
    _fbx = 'BistroInterior.fbx'
sceneBuilder.importScene(_fbx)

# Camera — position copied from the animated FBX camera at ~frame 32 of its
# walkthrough (matches TestRender.py output), with a static look-at toward
# the back of the restaurant. Previous (-1.7, 5.3, 4.2) position was
# stuck inside a wall/staircase on cold ladder runs.
camera = Camera('VisCacheDefault')
camera.position = float3( 9.8, 2.0,  0.4)
camera.target   = float3( 0.0, 1.5, -5.0)
camera.up       = float3( 0.0, 1.0,  0.0)
camera.focalLength = 35.0
sceneBuilder.addCamera(camera)

# Boost all emissive materials (FBX defaults are far too dim)
for m in sceneBuilder.materials:
    m.emissiveFactor *= 1000

# Glass — make windows transparent (pattern from SirKero/RTProgressivePhotonMapper)
glass = sceneBuilder.getMaterial('MASTER_Glass_Exterior')
if glass:
    glass.specularTransmission = 1
    glass.roughness = 0
    glass.metallic = 0
    glass.doubleSided = True
    glass.indexOfRefraction = 1.55
    glass.nestedPriority = 5

tGlass = sceneBuilder.getMaterial('TransparentGlass')
if tGlass:
    tGlass.specularTransmission = 1
    tGlass.roughness = 0
    tGlass.metallic = 0
    tGlass.doubleSided = True
    tGlass.indexOfRefraction = 1.55
    tGlass.nestedPriority = 5

# Directional sunlight streaming through windows (warm afternoon)
sun = DirectionalLight('Sun')
sun.intensity = float3(2.0, 1.6, 1.1)
sun.direction = float3(0.5, -0.7, -0.5)
sceneBuilder.addLight(sun)

# IBL — San Giuseppe Bridge (ORCA, bundled with Bistro asset)
_ibl = _os.path.normpath(_os.path.join(_dir, '..', 'runtime', 'media', 'Bistro', 'san_giuseppe_bridge_4k.hdr'))
envMap = EnvMap(_ibl)
envMap.intensity = 1.0
sceneBuilder.envMap = envMap

# Render settings — emissive geometry is the primary illumination indoors
settings = sceneBuilder.renderSettings
settings.useAnalyticLights = True
settings.useEmissiveLights = True
settings.useEnvLight = True
