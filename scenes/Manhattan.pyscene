# Manhattan.pyscene — Manhattan Island OSM buildings (Sketchfab)
# City-scale test scene: ~21 km x 3.7 km, 2.9M triangles.
#
# Download manually from Sketchfab (free, CC-BY 4.0):
#   https://sketchfab.com/3d-models/manhattan-osm-complete-model-bad7b7c7c6a64febb83950c24fee4d00
# Place extracted files in runtime/media/Manhattan/
#
# Credit: MENUDQ2 / noahquintana9, OpenStreetMap contributors

import os

_dir = os.path.dirname(os.path.abspath(__file__))
_candidates = [
    # Sketchfab downloads as glTF by default
    (os.path.join(_dir, '..', 'runtime', 'media', 'Manhattan', 'scene.gltf'), 'scene.gltf'),
    (os.path.join(_dir, '..', 'runtime', 'media', 'Manhattan', 'scene.glb'), 'scene.glb'),
    (os.path.join(_dir, '..', 'runtime', 'media', 'Manhattan', 'manhattan.obj'), 'manhattan.obj'),
    ('scene.gltf', 'scene.gltf'),
    ('manhattan.obj', 'manhattan.obj'),
]
_model = None
for _path, _name in _candidates:
    if os.path.exists(_path):
        _model = _path
        break

if _model is None:
    raise FileNotFoundError(
        'Manhattan model not found. Download from Sketchfab:\n'
        '  https://sketchfab.com/3d-models/manhattan-osm-complete-model-bad7b7c7c6a64febb83950c24fee4d00\n'
        'Extract to runtime/media/Manhattan/'
    )

sceneBuilder.importScene(_model)

# Camera — aerial view over Midtown looking north
camera = Camera('VisCacheDefault')
camera.position = float3(0.0, 500.0, -2000.0)
camera.target   = float3(0.0, 50.0, 2000.0)
camera.up       = float3(0.0, 1.0, 0.0)
camera.focalLength = 35.0
camera.farPlane = 50000.0
sceneBuilder.addCamera(camera)

# Sun — afternoon light raking across the grid
sun = DirectionalLight('Sun')
sun.intensity = float3(6.0, 5.2, 4.0)
sun.direction = float3(0.5, -0.8, 0.3)
sceneBuilder.addLight(sun)

sky = DirectionalLight('SkyFill')
sky.intensity = float3(0.6, 0.7, 1.0)
sky.direction = float3(-0.2, -1.0, -0.1)
sceneBuilder.addLight(sky)

settings = sceneBuilder.renderSettings
settings.useAnalyticLights = True
settings.useEmissiveLights = True
settings.useEnvLight = True
