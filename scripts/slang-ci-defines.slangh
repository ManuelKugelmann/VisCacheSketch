// slang-ci-defines.slangh — Default Falcor defines for offline CI compilation.
//
// These mirror the values that Falcor's Scene::updateSceneDefines(),
// MaterialSystem::getDefines(), PathTracer::StaticParams::getDefines(),
// ReSTIRPTPass::StaticParams::getDefines(), and RTXDIPass inject at runtime.
// We enable as many code paths as possible to maximise coverage.
//
// NOT shipped in the build — CI only.
//
// Sources:
//   Falcor/Source/Falcor/Scene/Scene.cpp                    updateSceneDefines()
//   Falcor/Source/Falcor/Scene/HitInfo.cpp                  HitInfo::getDefines()
//   Falcor/Source/Falcor/Scene/Material/MaterialSystem.cpp  getDefines()
//   Falcor/Source/RenderPasses/PathTracer/PathTracer.cpp    StaticParams::getDefines()
//   Source/RenderPasses/ReSTIRPTPass/ReSTIRPTPass.cpp       StaticParams::getDefines()
//   Falcor/Source/RenderPasses/RTXDIPass/RTXDIPass.cpp      updatePrograms()

#pragma once

// ---- Platform / NVAPI ------------------------------------------------------
#define FALCOR_NVAPI_AVAILABLE 0

// ---- Scene geometry --------------------------------------------------------
#ifndef SCENE_GEOMETRY_TYPES
#define SCENE_GEOMETRY_TYPES 2          // triangle mesh only (1 << GEOMETRY_TYPE_TRIANGLE_MESH)
#endif
#define SCENE_GRID_COUNT 0
#define SCENE_HAS_INDEXED_VERTICES 1
#define SCENE_HAS_16BIT_INDICES 0
#define SCENE_HAS_32BIT_INDICES 1

// ---- Scene rendering -------------------------------------------------------
#define SCENE_DIFFUSE_ALBEDO_MULTIPLIER 1.0

// ---- HitInfo ---------------------------------------------------------------
#define HIT_INFO_DEFINES 1
#define HIT_INFO_USE_COMPRESSION 0
#define HIT_INFO_TYPE_BITS 1
#define HIT_INFO_INSTANCE_ID_BITS 16
#define HIT_INFO_PRIMITIVE_INDEX_BITS 32

// ---- SDF grids (none) ------------------------------------------------------
#define SCENE_SDF_GRID_COUNT 0
#define SCENE_SDF_GRID_MAX_LOD_COUNT 0
#define SCENE_SDF_GRID_IMPLEMENTATION_NDSDF 0
#define SCENE_SDF_GRID_IMPLEMENTATION_SVS 1
#define SCENE_SDF_GRID_IMPLEMENTATION_SBS 2
#define SCENE_SDF_GRID_IMPLEMENTATION_SVO 3
#define SCENE_SDF_NO_INTERSECTION_METHOD 0
#define SCENE_SDF_NO_VOXEL_SOLVER 1
#define SCENE_SDF_VOXEL_SPHERE_TRACING 2
#define SCENE_SDF_NO_GRADIENT_EVALUATION_METHOD 0
#define SCENE_SDF_GRADIENT_NUMERIC_DISCONTINUOUS 1
#define SCENE_SDF_GRADIENT_NUMERIC_CONTINUOUS 2
#define SCENE_SDF_GRID_IMPLEMENTATION 0
#define SCENE_SDF_VOXEL_INTERSECTION_METHOD 0
#define SCENE_SDF_GRADIENT_EVALUATION_METHOD 0
#define SCENE_SDF_SOLVER_MAX_ITERATION_COUNT 0
#define SCENE_SDF_OPTIMIZE_VISIBILITY_RAYS 0

// ---- Sample generator ------------------------------------------------------
// TinyUniform (type 0) is required by ReSTIRPTPass which uses
// SampleGenerator(uint) constructor and accesses rng.state as uint.
#define SAMPLE_GENERATOR_TYPE 0         // SAMPLE_GENERATOR_TINY_UNIFORM

// ---- Material system -------------------------------------------------------
#define MATERIAL_SYSTEM_SAMPLER_DESC_COUNT 16
#define MATERIAL_SYSTEM_TEXTURE_DESC_COUNT 1
#define MATERIAL_SYSTEM_BUFFER_DESC_COUNT 1
#define MATERIAL_SYSTEM_TEXTURE_3D_DESC_COUNT 1
#define MATERIAL_SYSTEM_UDIM_INDIRECTION_ENABLED 0
#define MATERIAL_SYSTEM_HAS_SPEC_GLOSS_MATERIALS 0
#define MATERIAL_SYSTEM_USE_LIGHT_PROFILE 0
#define FALCOR_MATERIAL_INSTANCE_SIZE 128

// ---- Mesh split-buffer defines (SplitBuffer::getShaderDefines) -------------
#define VERTEX_POSITION_BUFFER_COUNT 1
#define VERTEX_POSITION_BUFFER_INDEX_BITS 0
#define VERTEX_STATIC_DATA_BUFFER_COUNT 1
#define VERTEX_STATIC_DATA_BUFFER_INDEX_BITS 0

// ---- Shared path-tracer defines (PathTracer + ReSTIRPTPass) ----------------
#define SAMPLES_PER_PIXEL 1
#define MAX_SURFACE_BOUNCES 10
#define MAX_DIFFUSE_BOUNCES 3
#define MAX_SPECULAR_BOUNCES 10
#define MAX_TRANSMISSON_BOUNCES 10
#define ADJUST_SHADING_NORMALS 1
#define USE_BSDF_SAMPLING 1
#define USE_NEE 1
#define USE_MIS 1
#define USE_RUSSIAN_ROULETTE 1
#define USE_ALPHA_TEST 1
#define USE_LIGHTS_IN_DIELECTRIC_VOLUMES 0
#define LIMIT_TRANSMISSION 0
#define MAX_TRANSMISSION_REFLECTION_DEPTH 0
#define MAX_TRANSMISSION_REFRACTION_DEPTH 0
#define DISABLE_CAUSTICS 0
#define DISABLE_DIRECT_ILLUMINATION 0
#define PRIMARY_LOD_MODE 0              // TexLODMode::Mip0
#define USE_NRD_DEMODULATION 0
#define COLOR_FORMAT 0
#define MIS_HEURISTIC 1                 // BalanceHeuristic
#define MIS_POWER_EXPONENT 2.0
#define INTERIOR_LIST_SLOT_COUNT 2
#define GBUFFER_ADJUST_SHADING_NORMALS 1

// ---- PathTracer-specific defines -------------------------------------------
// Enable most features to maximise code coverage during CI checks.
#define USE_VIEW_DIR 0
#define USE_RTXDI 0                     // No RTXDI SDK in CI
#define USE_SER 0                       // No SER support in CI
#define USE_ENV_LIGHT 1
#define USE_ANALYTIC_LIGHTS 1
#define USE_EMISSIVE_LIGHTS 1
#define USE_CURVES 0
#define USE_SDF_GRIDS 0
#define USE_HAIR_MATERIAL 0

// ---- RTXDIPass defines -----------------------------------------------------
#define USE_ENV_BACKGROUND 1
// is_valid_<name> defines for optional I/O resources (RTXDIPass FinalShading)
#define is_valid_gColor 1
#define is_valid_gEmission 1
#define is_valid_gDiffuseIllumination 1
#define is_valid_gDiffuseReflectance 1
#define is_valid_gSpecularIllumination 1
#define is_valid_gSpecularReflectance 1

// ---- VisCache integration --------------------------------------------------
// Default USE_VISCACHE=0 for host pass shaders (PathTracer, ReSTIRPTPass, etc.)
// where VisCache extensions are guarded by this define.  VisCache-internal
// shaders (Insert, Decay, RevalidationCommon) override to 1 via -D flag in
// slang-ci-check.sh.
#define USE_VISCACHE 0
#define USE_VISCACHE_REVAL 0
#define USE_LOCAL_REVAL 0

// ---- Output channels -------------------------------------------------------
// Enable guide/NRD/time outputs to compile those code paths.
#define OUTPUT_GUIDE_DATA 1
#define OUTPUT_TIME 1
#define OUTPUT_NRD_DATA 1
#define OUTPUT_NRD_ADDITIONAL_DATA 1

// ---- ReSTIRPTPass-specific defines -----------------------------------------
#define CANDIDATE_SAMPLES 1
