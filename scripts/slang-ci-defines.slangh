#define PATH_SAMPLING_MODE 0
#define _USE_DETERMINISTIC_BSDF 0
#define _USE_LEGACY_SHADING_CODE 0
#define NEIGHBOR_OFFSET_COUNT 8192
#define SPATIAL_RESTIR_MIS_KIND 0
#define TEMPORAL_RESTIR_MIS_KIND 0
#define TEMPORAL_UPDATE_FOR_DYNAMIC_SCENE 0
#define BPR 0
#define SEPARATE_PATH_BSDF 0
#define RCDATA_PATH_NUM 6
#define RCDATA_PAD_SIZE 1

